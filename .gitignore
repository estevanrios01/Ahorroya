# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored (no leading slash) so this also covers apps/*/node_modules,
# packages/*/node_modules, etc. -- the original create-next-app template
# only anchored at the repo root, which silently let node_modules/.next
# inside apps/admin (a separate, non-workspace Next.js app) go untracked
# by this file entirely.
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# env files (never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# local Codex agent tooling
.agents/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts
